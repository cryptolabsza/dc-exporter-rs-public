[Unit]
Description=DC Exporter - GPU Metrics for Prometheus
Documentation=https://github.com/CrypotAI/dc-exporter
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/dc-exporter --config /etc/dc-exporter/config.toml --port 9400
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp /var/tmp
PrivateTmp=true

# Allow access to GPU devices and /dev/mem for register access
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
